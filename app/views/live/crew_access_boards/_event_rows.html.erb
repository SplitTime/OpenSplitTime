<%# locals: (board:) -%>

<%= turbo_frame_tag dom_id(board.gating_location_event, :crew_access_rows) do %>
  <% rows = board.rows %>
  <% if rows.any? %>
    <table class="table table-striped mb-0">
      <thead>
      <tr>
        <th>Bib</th>
        <th>Name</th>
        <th class="text-center"><%= board.gating_location_event.gating_split.base_name %> <%= board.gating_location_event.gating_sub_split_kind %></th>
        <th class="text-center">Expected at <%= board.gating_location_event.target_split.base_name %></th>
        <th class="text-end">Release</th>
        <th class="text-center">Crew</th>
      </tr>
      </thead>
      <tbody>
      <%= render partial: "live/crew_access_boards/row", collection: rows, as: :row, locals: { board: board } %>
      </tbody>
    </table>
  <% else %>
    <p class="text-body-secondary mb-0">No runners match the current filters.</p>
  <% end %>
<% end %>
