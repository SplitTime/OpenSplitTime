<% content_for :title do %>
  <% "OpenSplitTime: Crew Access - #{@presenter.event_group.name}" %>
<% end %>

<header class="ost-header">
  <div class="container">
    <div class="ost-heading row">
      <div class="col">
        <div class="ost-title">
          <h1 class="fw-bold">Crew Access</h1>
          <ul class="breadcrumb breadcrumb-ost">
            <li class="breadcrumb-item"><%= link_to "Organizations", organizations_path %></li>
            <li class="breadcrumb-item"><%= link_to @presenter.organization.name, organization_path(@presenter.organization) %></li>
            <li class="breadcrumb-item"><%= link_to @presenter.event_group.name, event_group_path(@presenter.event_group) %></li>
            <li class="breadcrumb-item active">Crew Access</li>
          </ul>
        </div>
      </div>
    </div>
    <%= render "events/view_buttons", view_object: @presenter %>
  </div>
</header>

<article class="ost-article container">
  <% if @presenter.event_group.gating_locations.exists? %>
    <% @presenter.event_group.gating_locations.includes(gating_location_events: :event).find_each do |gating_location| %>
      <% gated_events = gating_location.gating_location_events.sort_by { |gle| gle.event.guaranteed_short_name } %>
      <% if gated_events.one? %>
        <%= link_to live_event_group_crew_access_board_path(@presenter.event_group, gated_events.first),
                    class: "text-decoration-none" do %>
          <div class="card my-2">
            <div class="card-body d-flex align-items-center justify-content-between">
              <h5 class="fw-bold mb-0"><%= gating_location.name %></h5>
              <span class="text-body-secondary">&rarr;</span>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="card my-2">
          <div class="card-body">
            <h5 class="fw-bold"><%= gating_location.name %></h5>
            <div class="list-group list-group-flush">
              <% gated_events.each do |gating_location_event| %>
                <%= link_to live_event_group_crew_access_board_path(@presenter.event_group, gating_location_event),
                            class: "list-group-item list-group-item-action d-flex align-items-center justify-content-between" do %>
                  <span><%= gating_location_event.event.guaranteed_short_name %></span>
                  <span class="text-body-secondary">&rarr;</span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <div class="callout callout-info">
      <h5>No gating locations are configured for this event group.</h5>
      <p>Set up Crew Access gating locations in the event group construction area.</p>
    </div>
  <% end %>
</article>
